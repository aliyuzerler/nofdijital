# NOF Dijital — ortam değişkenleri örneği
# Gerçek değerleri .env dosyasında tutun (.env repoya girmez).

# Uygulama
APP_URL=http://localhost:3000

# Veritabanı: pglite (lokal/sandbox) | postgres (Neon vb.)
DATABASE_DRIVER=pglite
PGLITE_DATA_DIR=db/pgdata
# DATABASE_DRIVER=postgres iken:
# DATABASE_URL=postgresql://user:pass@host:5432/db?sslmode=require

# Kimlik (Better Auth) — üretimde mutlaka değiştirin: openssl rand -hex 32
AUTH_SECRET=change-me-openssl-rand-hex-32

# Depolama: local | vercel-blob
STORAGE_PROVIDER=local
# STORAGE_PROVIDER=vercel-blob iken:
# BLOB_READ_WRITE_TOKEN=
# BLOB_PUBLIC_BASE_URL=

# Seed: 1 = örnek yazılar yayınlanmış, 0 = taslak (üretimde 0)
SEED_PUBLISH_POSTS=1
